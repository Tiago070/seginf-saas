# Versão sugerida do Ubuntu Server a ser usada no laboratório.
UBUNTU_VERSAO="24.04 LTS"

# Endereço da rede local LAN do laboratório.
LAN_REDE="10.10.10.0/24"
# Endereço do servidor na rede local LAN.
LAN_IP_SERVIDOR="10.10.10.1"
# Endereço da estação administrativa na rede local LAN.
LAN_IP_ESTACAO_ADMIN="DEFINIR"

# Endereço IP do servidor na rede externa WAN.
WAN_IP_SERVIDOR="DEFINIR"
# Faixa de endereços da rede externa WAN.
WAN_REDE="DEFINIR"
# Endereço do gateway da rede externa WAN.
WAN_GATEWAY="DEFINIR"
# Endereço do cliente externo usado nos testes.
WAN_IP_CLIENTE_EXTERNO="DEFINIR"

# Rede de destino da rota estática adicional.
ROTA_ESTATICA_REDE="10.10.20.0/24"
# Próximo salto da rota estática adicional.
ROTA_ESTATICA_VIA="10.10.10.2"

# Porta de administração remota por SSH.
PORTA_SSH="22022"
# Porta do serviço HTTP.
PORTA_HTTP="80"
# Porta do serviço HTTPS.
PORTA_HTTPS="443"
# Porta do banco de dados.
PORTA_DB="5432"

# Nome da interface de rede conectada à LAN.
IFACE_LAN="DEFINIR"
# Nome da interface de rede conectada à WAN.
IFACE_WAN="DEFINIR"

# Lista de contas administrativas nominais dos integrantes.
USUARIOS_ADMIN="DEFINIR"
# Nome da conta de serviço usada para deploy.
USUARIO_DEPLOY="deploy"

# Caminho do arquivo com as regras do iptables.
ARQUIVO_REGRAS_IPTABLES="DEFINIR"
# Caminho do diretório com o baseline de integridade.
DIR_BASELINE_INTEGRIDADE="DEFINIR"
