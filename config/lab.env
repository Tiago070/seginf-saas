# Versão comum às três VMs para manter o ambiente homogêneo.
UBUNTU_VERSAO="26.04.1 LTS"

# Endereço da rede local LAN do laboratório.
LAN_REDE="10.10.10.0/24"
# Endereço temporário observado no servidor; confirmar como IP estático na Etapa 2.
LAN_IP_SERVIDOR="10.10.10.1"
# Endereço temporário observado na estação; confirmar como IP estático na Etapa 2.
LAN_IP_ESTACAO_ADMIN="10.10.10.10"

# Endereços WAN observados por DHCP no teste inicial; confirmar após reiniciar.
WAN_IP_SERVIDOR="10.0.2.3"
WAN_REDE="10.0.2.0/24"
WAN_GATEWAY="10.0.2.1"
WAN_IP_CLIENTE_EXTERNO="10.0.2.4"

# Rede de destino da rota estática atrás da estação administrativa.
ROTA_ESTATICA_REDE="10.10.20.0/24"
# Endereço da estação administrativa na LAN, usado como próximo salto.
ROTA_ESTATICA_VIA="10.10.10.2"
# Rede Interna do VirtualBox atrás do roteador estacao-admin.
REDE_INTERNA_ROTEADA="lan-ci"
# Endereço do roteador na rede interna roteada.
IP_ROTEADOR_REDE_ROTEADA="10.10.20.1"

# Porta de administração remota por SSH.
PORTA_SSH="22022"
# Porta do serviço HTTP.
PORTA_HTTP="80"
# Porta do serviço HTTPS.
PORTA_HTTPS="443"
# Porta do banco de dados.
PORTA_DB="5432"
# Encaminhamento IPv4 exigido para rotear tráfego entre interfaces.
IPV4_FORWARD="1"

# Interfaces observadas; confirmar associação dos adaptadores no VirtualBox.
IFACE_LAN="enp0s8"
IFACE_WAN="enp0s3"
IFACE_LAN_ESTACAO_ADMIN="enp0s3"
# Interface observada no segundo adaptador; confirmar a associação antes de reaplicar.
IFACE_REDE_ROTEADA="enp0s8"

# Lista de contas administrativas nominais dos integrantes.
USUARIOS_ADMIN="DEFINIR"
# Nome da conta de serviço usada para deploy.
USUARIO_DEPLOY="deploy"

# Caminho do arquivo com as regras do iptables.
ARQUIVO_REGRAS_IPTABLES="DEFINIR"
# Caminho do diretório com o baseline de integridade.
DIR_BASELINE_INTEGRIDADE="DEFINIR"

# Resolvedores IPv4 separados por vírgula; escolher servidores acessíveis pela WAN do laboratório.
DNS_SERVERS="8.8.8.8,1.1.1.1"
# Prazo para confirmar netplan try no console da VM, em segundos.
NETPLAN_TRY_TIMEOUT="120"

# Validade do certificado autoassinado de laboratório, em dias.
TLS_CERT_DAYS="365"
# Nome incluído no certificado autoassinado local.
TLS_COMMON_NAME="srv-saas"
# Caminhos locais do certificado público e da chave privada do Nginx.
TLS_CERT_PATH="/etc/ssl/certs/saas-lab.crt"
TLS_KEY_PATH="/etc/ssl/private/saas-lab.key"

# Identificadores da base e do papel de exemplo, sem credenciais fixas.
DB_NAME="saas_demo"
DB_USER="saas_app"
